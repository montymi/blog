{
  "name": "blog-de-miguel",
  "version": "1.0.0",
  "type": "module",
  "description": "Personal portfolio, blog, and virtual sandbox of Michael Montanaro",
  "homepage": "https://blog-michael-montanaros-projects.vercel.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/montymi/blog.git"
  },
  "bugs": {
    "url": "https://github.com/montymi/blog/issues",
    "email": "mcmontanaor01@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "vercel deploy",
    "https-preview": "serve dist",
    "prepare": "husky install && cp -n env/.shared .env &",
    "prettier:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "lint:check": "eslint --max-warnings=0 .",
    "ts:check": "tsc --noEmit",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@vercel/analytics": "^1.4.1",
    "@vercel/node": "^5.1.2",
    "@vercel/speed-insights": "^1.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^4.0.11",
    "react-helmet-async": "^2.0.3",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.21.0",
    "rehype-raw": "^7.0.0",
    "vite-plugin-vercel": "^9.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.40.1",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^15.0.7",
    "@testing-library/user-event": "^14.5.2",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/node": "^20.10.4",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "gh-pages": "^6.2.0",
    "https-localhost": "^4.7.1",
    "husky": "^8.0.3",
    "jsdom": "^24.1.3",
    "lint-staged": "^15.2.0",
    "postcss": "^8.4.49",
    "prettier": "3.1.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.0.9",
    "vite-plugin-pwa": "^0.17.4",
    "vitest": "^1.1.3"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write"
    ],
    "src/**/*.{js,jsx,ts,tsx,json}": [
      "eslint --max-warnings=0"
    ]
  },
  "author": {
    "name": "Michael Montanaro",
    "email": "mcmontanaro01@gmail.com",
    "url": "https://montymi.com"
  },
  "keywords": [
    "react",
    "pwa",
    "portfolio",
    "vite",
    "blog"
  ]
}
